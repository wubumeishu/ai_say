# ============================================================
# Ai SAY .gitignore — 原则：代码 + 文档进库；数据 + 密钥绝不上库
# ============================================================

# 依赖
node_modules/

# 运行数据与客户隐私（客户画像/消息/缓存，一律不进库）
data/
backups/
platform/

# 密钥与本地配置（含模型 apiKey、窗口 id）
settings.json
# 代理密码与池数据（手动维护，绝不上库）
data/proxy-secrets.json
data/proxy-pool.json
data/happy-cache.json  # H4 快乐平台缓存（§0.3 数据不进 Git，仿 console-cache.json）

# 日志 / 进程文件 / 运行残留
*.log
console.log
console.pid
_startup*.log
undefined/
logs/

# Windows 杂项
Thumbs.db
Desktop.ini

# 一次性验证/提交脚本（勿入库）
_commit_msg.txt
_syntax_check.js
test-deep-debug*.js
